{
  "description": "Fleet workflows' two opt-in guards (fleet-guard), off unless .fleet/workflow.json turns them on: agents.enforceBriefs checks Agent briefs, agents.unpushedWork flags worktree commits on no remote.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/fleet-guard",
              "brief"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/fleet-guard",
              "unpushed"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
