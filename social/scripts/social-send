#!/bin/sh
# Fleet Social's sender: runs detached, one at a time (a mkdir lock), and posts this computer's presence to
# POST /api/social/presence as { "project", "state", "mood" } and nothing else:
#   project  the display name of the most recently active open session's project (its folder name, never a path)
#   state    active (working), idle (waiting for you) or ended (no session left open here)
#   mood     optional: the average of that session's last 5 prompt scores, computed by the hook (never the prompt)
# About once a minute at most, plus right away at a session's start and end. If something changed inside the minute,
# it waits for the minute to be up and sends the latest, so the last word lands. A server without the endpoint (404)
# turns it off for an hour; nothing is ever printed.
HERE=$(dirname "$0")
. "$HERE/lib.sh" 2>/dev/null || exit 0

GAP=60      # seconds between sends
LIVE=900    # a session quiet longer than this isn't at sea any more (World's live window)
STALE=21600 # a session file this old lost its SessionEnd (a crash): dropped

mkdir -p "$SOC/sessions" 2>/dev/null || exit 0
LOCK="$SOC/send.lock"
if ! mkdir "$LOCK" 2>/dev/null; then
  pid=$(cat "$LOCK/pid" 2>/dev/null)
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then exit 0; fi
  rm -rf "$LOCK" 2>/dev/null
  mkdir "$LOCK" 2>/dev/null || exit 0
fi
echo $$ >"$LOCK/pid"
RESP="$SOC/resp.$$"
BODY="$SOC/body.$$"
trap 'rm -rf "$LOCK" "$RESP" "$BODY"' EXIT

KEY=$(fleet_key)
[ -n "$KEY" ] || exit 0
case "$KEY" in *[!A-Za-z0-9_-]*) exit 0 ;; esac
SERVER=$(fleet_server)

now() { date +%s; }

# A server that doesn't know Fleet Social yet (404), or a key it refused (401/403), rests the sender a while.
off=$(cat "$SOC/off-until" 2>/dev/null)
case "$off" in "" | *[!0-9]*) off=0 ;; esac
[ "$(now)" -lt "$off" ] && exit 0

# Let the full fleet plugin's hook mark a brand-new session first (both start at once).
sleep 2

# This computer's presence as JSON, into PAYLOAD (empty: nothing to say).
presence() {
  PAYLOAD="" best="" best_at=0 t=$(now)
  for f in "$SOC"/sessions/*; do
    [ -f "$f" ] || continue
    sid=$(basename "$f")
    case "$sid" in *.tmp.*) continue ;; esac
    # The full plugin took this session over (installed meanwhile): it's not ours to report.
    if full_reports "$sid"; then rm -f "$f"; continue; fi
    at=$(sed -n 3p "$f" 2>/dev/null)
    case "$at" in "" | *[!0-9]*) rm -f "$f"; continue ;; esac
    [ $((t - at)) -gt "$STALE" ] && { rm -f "$f"; continue; }
    [ $((t - at)) -gt "$LIVE" ] && continue
    [ "$at" -ge "$best_at" ] && { best=$f; best_at=$at; }
  done
  if [ -n "$best" ]; then
    project=$(sed -n 1p "$best" | tr -cd 'A-Za-z0-9._ -' | cut -c 1-64)
    state=$(sed -n 2p "$best")
    case "$state" in active | idle) ;; *) state=idle ;; esac
    mood=""
    if mood_on; then
      mood=$(sed -n 4p "$best" | awk '{ n = 0; s = 0; for (i = (NF > 5 ? NF - 4 : 1); i <= NF; i++) if ($i ~ /^-?[0-2]$/) { s += $i; n++ } if (n) printf "%.1f", s / n }')
    fi
    [ -n "$project" ] || project="project"
    PAYLOAD="{\"project\":\"$project\",\"state\":\"$state\"${mood:+,\"mood\":$mood}}"
  else
    # Nothing open here any more: ashore, once (the last port we reported, so it's the one that's left).
    last=$(sed -n 2p "$SOC/sent" 2>/dev/null)
    case "$last" in
    *'"state":"ended"'* | "") ;;
    *)
      project=$(printf '%s' "$last" | sed -n 's/^{"project":"\([A-Za-z0-9._ -]*\)".*$/\1/p')
      PAYLOAD="{\"project\":\"${project:-project}\",\"state\":\"ended\"}"
      ;;
    esac
  fi
}

# POST PAYLOAD. Sets CODE (000 when unreachable).
post() {
  printf '%s' "$PAYLOAD" >"$BODY"
  CODE=$(printf 'header = "Authorization: Bearer %s"\n' "$KEY" |
    curl -sS -K - -m 15 -o "$RESP" -w '%{http_code}' -X POST -A "$UA" -H 'content-type: application/json' \
      --data-binary "@$BODY" "$SERVER/api/social/presence" 2>>"$SOC/log")
  case "$CODE" in [0-9][0-9][0-9]) ;; *) CODE=000 ;; esac
}

tries=0
while :; do
  presence
  [ -n "$PAYLOAD" ] || exit 0
  last_at=$(sed -n 1p "$SOC/sent" 2>/dev/null)
  case "$last_at" in "" | *[!0-9]*) last_at=0 ;; esac
  last=$(sed -n 2p "$SOC/sent" 2>/dev/null)
  since=$(($(now) - last_at))
  if [ ! -f "$SOC/force" ] && [ "$since" -lt "$GAP" ]; then
    # Inside the minute: nothing new, nothing to do; something new, send it when the minute is up (or at once for an end).
    [ "$PAYLOAD" = "$last" ] && exit 0
    i=$((GAP - since))
    while [ "$i" -gt 0 ] && [ ! -f "$SOC/force" ]; do
      sleep 2
      i=$((i - 2))
    done
    continue
  fi
  rm -f "$SOC/force"
  post
  case "$CODE" in
  2??)
    printf '%s\n%s\n' "$(now)" "$PAYLOAD" >"$SOC/sent.tmp.$$" && mv -f "$SOC/sent.tmp.$$" "$SOC/sent"
    # Anything that happened while we were sending goes out on the next round (the minute applies).
    presence
    [ -n "$PAYLOAD" ] && [ "$PAYLOAD" != "$(sed -n 2p "$SOC/sent" 2>/dev/null)" ] && continue
    exit 0
    ;;
  404)
    slog "this Fleet server has no Fleet Social presence endpoint yet ($SERVER); resting for an hour"
    echo $(($(now) + 3600)) >"$SOC/off-until"
    exit 0
    ;;
  401 | 403)
    slog "the key was refused ($CODE); run /fleet-social:login again. Resting for 10 minutes"
    echo $(($(now) + 600)) >"$SOC/off-until"
    exit 0
    ;;
  *)
    tries=$((tries + 1))
    slog "presence: $CODE $(head -c 200 "$RESP" 2>/dev/null); $([ "$tries" -lt 3 ] && echo "will retry" || echo "giving up until the next event")"
    [ "$tries" -lt 3 ] || exit 0
    sleep $((tries * 10))
    : >"$SOC/force"
    ;;
  esac
done
